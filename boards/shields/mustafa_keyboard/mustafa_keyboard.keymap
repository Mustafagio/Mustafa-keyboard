#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Türkçe Q";

            bindings = <
                // =========================================================
                // R0 — ESC 1 2 3 4 5 6 7 8 9 0 = - BACKSPACE
                // =========================================================
                &kp ESC
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp N5
                &kp N6
                &kp N7
                &kp N8
                &kp N9
                &kp N0
                &kp EQUAL
                &kp MINUS
                &kp BSPC

                // =========================================================
                // R1 — TAB Q W E R T Y U I O P Ğ Ü ,
                // =========================================================
                &kp TAB
                &kp Q
                &kp W
                &kp E
                &kp R
                &kp T
                &kp Y
                &kp U
                &kp I
                &kp O
                &kp P
                &kp LBKT
                &kp RBKT

                // DÜZELTİLDİ:
                // Fiziksel virgül tuşu -> BSLH
                &kp BSLH

                // =========================================================
                // R2 — CAPS A S D F G H J K L Ş İ ENTER
                // =========================================================
                &kp CAPSLOCK
                &kp A
                &kp S
                &kp D
                &kp F
                &kp G
                &kp H
                &kp J
                &kp K
                &kp L
                &kp SEMICOLON
                &kp SQT
                &kp ENTER

                // =========================================================
                // R3 — SHIFT Z X C V B N M Ö Ç . RSHIFT UP DEL
                // =========================================================
                &kp LSHIFT
                &kp Z
                &kp X
                &kp C
                &kp V
                &kp B
                &kp N
                &kp M

                // DÜZELTİLDİ:
                // Fiziksel Ö tuşu -> PERIOD
                &kp PERIOD

                // DÜZELTİLDİ:
                // Fiziksel Ç tuşu -> COMMA
                &kp COMMA

                // DÜZELTİLDİ:
                // Fiziksel nokta tuşu -> FSLH
                &kp FSLH

                &kp RSHIFT
                &kp UP
                &kp DEL

                // =========================================================
                // R4 — CTRL WIN ALT SPACE ALTGR FN LEFT DOWN RIGHT
                // =========================================================
                &kp LCTRL
                &kp LGUI
                &kp LALT
                &kp SPACE
                &kp RALT
                &mo 1
                &kp LEFT
                &kp DOWN
                &kp RIGHT
            >;
        };


        // =============================================================
        // FN LAYER
        // =============================================================
        fn_layer {
            display-name = "FN";

            bindings = <
                // =========================================================
                // R0
                // ESC F1 F2 F3 F4 F5 F6 F7 F8 F9 F10 F11 F12 BACKSPACE
                // =========================================================
                &kp ESC
                &kp F1
                &kp F2
                &kp F3
                &kp F4
                &kp F5
                &kp F6
                &kp F7
                &kp F8
                &kp F9
                &kp F10
                &kp F11
                &kp F12
                &kp BSPC

                // =========================================================
                // R1 — 14 TUŞ
                // =========================================================
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                // =========================================================
                // R2 — 13 TUŞ
                // =========================================================
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                // =========================================================
                // R3 — 14 TUŞ
                // =========================================================
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                // =========================================================
                // R4 — 9 TUŞ
                // =========================================================
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
            >;
        };
    };
};
